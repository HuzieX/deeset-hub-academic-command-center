# Environment example

# JWT secret (CHANGE THIS FOR PRODUCTION)
JWT_SECRET=deeset-prod-secret-change-me

# Postgres connection (the compose.prod uses the db service)
DATABASE_URL=postgresql://deeset:deesetpass@db:5432/deesetdb

# Node env
NODE_ENV=production

# Optional S3 (leave blank to use local uploads)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
